PokemonTower_6F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PokemonTower_6F_OnTransition
	.byte 0

PokemonTower_6F_OnTransition::
	setvar VAR_TEMP_0, 0
	call_if_unset FLAG_POKEMON_TOWER_MAROWAK_IS_RECOVERING, PokemonTower_6F_EventScript_TryShowMarowak
	end

PokemonTower_6F_EventScript_TryShowMarowak::
	goto_if_set FLAG_CAUGHT_POKEMON_TOWER_MAROWAK, EventScript_Return
	setvar VAR_MAP_SCENE_POKEMON_TOWER_6F, 0
	specialvar VAR_RESULT, ArchipelagoSpecial_BlockTower
	goto_if_eq VAR_RESULT, FALSE, EventScript_Return
	setvar VAR_MAP_SCENE_POKEMON_TOWER_1F, 0
	return

PokemonTower_6F_EventScript_MarowakGhost::
	lockall
	textcolor NPC_TEXT_COLOR_MON
	msgbox PokemonTower_6F_Text_BeGoneIntruders
	goto_if_questlog EventScript_ReleaseEnd
Archipelago_Target_Static_Encounter_MAROWAK::
	setwildbattle SPECIES_MAROWAK, 30
	special StartMarowakBattle
	waitstate
	special QuestLog_CutRecording
	goto_if_eq VAR_RESULT, FALSE, PokemonTower_6F_EventScript_DefeatedMarowakGhost  @ VAR_RESULT set by CB2_EndMarowakBattle
	call_if_eq VAR_TEMP_0, 0, PokemonTower_6F_EventScript_ForcePlayerUp
	call_if_eq VAR_TEMP_0, 1, PokemonTower_6F_EventScript_ForcePlayerLeft
	releaseall
	end

PokemonTower_6F_EventScript_DefeatedMarowakGhost::
	message PokemonTower_6F_Text_GhostWasCubonesMother
	waitmessage
	waitse
	playmoncry SPECIES_MAROWAK, CRY_MODE_NORMAL
	waitbuttonpress
	waitmoncry
	msgbox PokemonTower_6F_Text_MothersSpiritWasCalmed
	setvar VAR_MAP_SCENE_POKEMON_TOWER_6F, 1
	setvar VAR_MAP_SCENE_POKEMON_TOWER_1F, 1
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, PokemonTower_6F_EventScript_CaughtMarowak
	setflag FLAG_POKEMON_TOWER_MAROWAK_IS_RECOVERING
	releaseall
	end

PokemonTower_6F_EventScript_CaughtMarowak::
	setflag FLAG_CAUGHT_POKEMON_TOWER_MAROWAK
	releaseall
	end

PokemonTower_6F_EventScript_ForcePlayerUp::
	applymovement OBJ_EVENT_ID_PLAYER, PokemonTower_6F_Movement_ForcePlayerUp
	waitmovement 0
	return

PokemonTower_6F_EventScript_ForcePlayerLeft::
	applymovement OBJ_EVENT_ID_PLAYER, PokemonTower_6F_Movement_ForcePlayerLeft
	waitmovement 0
	return

PokemonTower_6F_Movement_ForcePlayerUp::
	walk_up
	step_end

PokemonTower_6F_Movement_ForcePlayerLeft::
	walk_left
	step_end

PokemonTower_6F_EventScript_Angelica::
	trainerbattle_single TRAINER_CHANNELER_ANGELICA, PokemonTower_6F_Text_AngelicaIntro, PokemonTower_6F_Text_AngelicaDefeat
	msgbox PokemonTower_6F_Text_AngelicaPostBattle, MSGBOX_AUTOCLOSE
	end

