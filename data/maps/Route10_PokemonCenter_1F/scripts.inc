.set REQUIRED_CAUGHT_MONS, VAR_TEMP_1

.equ GIVE_FLY_UNLOCK, VAR_TEMP_2

Route10_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Route10_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, Route10_PokemonCenter_1F_OnFrame
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

Route10_PokemonCenter_1F_OnTransition::
	specialvar VAR_RESULT, ArchipelagoSpecial_FlyUnlocks
	call_if_eq VAR_RESULT, TRUE, Route10_PokemonCenter_1F_EventScript_SetGiveFlyUnlockItem
	call_if_eq VAR_RESULT, FALSE, Route10_PokemonCenter_1F_EventScript_SetWorldMapFlag
	setrespawn SPAWN_ROUTE10
	setvar VAR_0x8003, 1
	specialvar REQUIRED_CAUGHT_MONS, ArchipelagoSpecial_GetProfessorOaksAideCount
	end

Route10_PokemonCenter_1F_EventScript_SetGiveFlyUnlockItem::
	goto_if_set FLAG_VISITED_ROUTE10 EventScript_Return
	setvar GIVE_FLY_UNLOCK, 1
	return

Route10_PokemonCenter_1F_EventScript_SetWorldMapFlag::
	setworldmapflag FLAG_WORLD_MAP_ROUTE10_POKEMON_CENTER_1F
	return

Route10_PokemonCenter_1F_OnFrame::
	map_script_2 GIVE_FLY_UNLOCK, 1, Route10_PokemonCenter_1F_EventScript_GiveFlyUnlockItem
	.2byte 0

Route10_PokemonCenter_1F_EventScript_GiveFlyUnlockItem::
	lockall
Archipelago_Target_Fly_Unlock_FLAG_VISITED_ROUTE10::
	giveitem ITEM_FLY_ROUTE10, 1, FLAG_VISITED_ROUTE10
	setvar GIVE_FLY_UNLOCK, 0
	releaseall
	end

Route10_PokemonCenter_1F_EventScript_Nurse::
	lock
	faceplayer
	call EventScript_PkmnCenterNurse
	release
	end

Route10_PokemonCenter_1F_EventScript_FatMan::
	msgbox Route10_PokemonCenter_1F_Text_NuggetUselessSoldFor5000, MSGBOX_NPC
	end

Route10_PokemonCenter_1F_EventScript_Gentleman::
	msgbox Route10_PokemonCenter_1F_Text_EveryTypeStrongerThanOthers, MSGBOX_NPC
	end

Route10_PokemonCenter_1F_EventScript_Youngster::
	msgbox Route10_PokemonCenter_1F_Text_HeardGhostsHauntLavender, MSGBOX_NPC
	end

Route10_PokemonCenter_1F_EventScript_Aide::
	lock
	faceplayer
Archipelago_Target_NPC_Gift_FLAG_GOT_EVERSTONE_FROM_OAKS_AIDE::
	setvar VAR_TEMP_4, ITEM_EVERSTONE
	goto_if_set FLAG_GOT_EVERSTONE_FROM_OAKS_AIDE, Route10_PokemonCenter_1F_EventScript_AlreadyGotEverstone
	call Route10_PokemonCenter_1F_EventScript_GetAideRequestInfo
	call Aide_EventScript_GiveIfSeenXMons
	setvar VAR_0x8003, FLAG_HINT_ROUTE_10_OAKS_AIDE
	goto_if_eq VAR_RESULT, NO, Aide_EventScript_DeclineCheckMons
	setvar VAR_0x8004, 1
	specialvar VAR_RESULT, GetPokedexCount
	buffernumberstring STR_VAR_4, VAR_0x8006
	call Route10_PokemonCenter_1F_EventScript_GetAideRequestInfo
	setvar VAR_0x8003, FLAG_HINT_ROUTE_10_OAKS_AIDE
	goto_if_lt VAR_0x8006, REQUIRED_CAUGHT_MONS, Aide_EventScript_HaventCaughtEnough
	msgbox Route10_PokemonCenter_1F_Text_GreatHereYouGo
	giveitem VAR_TEMP_4, 1, FLAG_GOT_EVERSTONE_FROM_OAKS_AIDE
	msgbox Route10_PokemonCenter_1F_Text_ExplainEverstone
	release
	end

Route10_PokemonCenter_1F_EventScript_AlreadyGotEverstone::
	msgbox Route10_PokemonCenter_1F_Text_ExplainEverstone
	release
	end

Route10_PokemonCenter_1F_EventScript_GetAideRequestInfo::
	setvar VAR_0x8003, FLAG_GOT_EVERSTONE_FROM_OAKS_AIDE
	buffernumberstring STR_VAR_1, REQUIRED_CAUGHT_MONS
	bufferapitemstrings STR_VAR_2, STR_VAR_3, VAR_0x8003, VAR_TEMP_4
	copyvar VAR_TEMP_3, VAR_RESULT
	return
